{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sec-overlay scan-profile",
  "type": "object",
  "required": ["languages", "frameworks", "entrypoints", "runnable", "attack_surface", "sast_plan", "agents_to_spawn", "budget_hint", "attack_surface_evidence"],
  "properties": {
    "languages": {"type": "array", "items": {"type": "string"}},
    "frameworks": {"type": "array", "items": {"type": "string"}},
    "entrypoints": {"type": "array", "items": {"type": "string"}},
    "runnable": {"type": "boolean"},
    "attack_surface": {"type": "array", "items": {"type": "string"}},
    "sast_plan": {"type": "object"},
    "agents_to_spawn": {"type": "array", "items": {"type": "string"}},
    "budget_hint": {"type": "object"},
    "attack_surface_evidence": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}},
      "description": "Maps each attack_surface key to file:line indicators justifying it. Required."
    },
    "subsystems": {
      "type": "array",
      "items": {"type": "object"},
      "description": "Optional input-processing subsystem partition; a repo with one subsystem may omit it."
    },
    "notes": {"type": "object", "description": "Optional free-form signals (e.g. {\"eol_frameworks\": [...]}); never required."},
    "scan_options": {
      "type": "object",
      "description": "Optional process knobs the orchestrator reads. Never required; absent => full depth + defaults.",
      "properties": {
        "adversary_depth": {"type": "string", "enum": ["full", "gate-by-exception"]},
        "model_tier_map": {"type": "object", "description": "Maps phase name to model tier."},
        "wave_k": {"type": "integer", "description": "Number of investigation slots per wave."},
        "max_waves": {"type": "integer", "description": "Maximum number of investigation waves."},
        "token_budget": {"type": "integer", "description": "Token budget cap for the scan."}
      }
    }
  }
}
