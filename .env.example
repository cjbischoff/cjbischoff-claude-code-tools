# OpenWiki local/CI configuration. Copy values into the environment or
# ~/.openwiki/.env before `openwiki code --init`. Never put a real key here.
#
# Repository secret for GitHub Actions: ANTHROPIC_API_KEY
#   gh secret set ANTHROPIC_API_KEY --repo cjbischoff/cjbischoff-claude-code-tools

OPENWIKI_PROVIDER=anthropic
OPENWIKI_MODEL_ID=claude-sonnet-5
OPENWIKI_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1
